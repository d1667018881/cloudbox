<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络基础 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 10+ 下载文件到公共目录需要（targetSdk 34 下仅对低版本生效，高版本走 MediaStore） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 13+ 通知权限（下载完成通知 / 后台上传进度通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 下载 APK 后跳转安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- WorkManager 后台上传任务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".CloudBoxApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudBox"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CloudBox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 支持从外部链接唤起解析（#17 修复：限定 lanzou 系 host，
                 旧实现无 host 过滤会变成全系统所有网页链接的候选打开方式） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="lanzou.com" />
                <data android:scheme="https" android:host="*.lanzou.com" />
                <data android:scheme="https" android:host="lanzoui.com" />
                <data android:scheme="https" android:host="*.lanzoui.com" />
                <data android:scheme="https" android:host="lanzoup.com" />
                <data android:scheme="https" android:host="*.lanzoup.com" />
                <data android:scheme="https" android:host="lanzoux.com" />
                <data android:scheme="https" android:host="*.lanzoux.com" />
                <data android:scheme="https" android:host="lanzouo.com" />
                <data android:scheme="https" android:host="*.lanzouo.com" />
                <data android:scheme="https" android:host="lanzouh.com" />
                <data android:scheme="https" android:host="*.lanzouh.com" />
                <data android:scheme="https" android:host="lanzouu.com" />
                <data android:scheme="https" android:host="*.lanzouu.com" />
            </intent-filter>
        </activity>

        <!-- WorkManager 使用 Hilt 自定义 WorkerFactory（CloudBoxApp 实现 Configuration.Provider），
             必须移除默认初始化器，否则运行时重复初始化（lint 强制要求） -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
