<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络基础 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 10+ 下载文件到公共目录需要（targetSdk 34 下仅对低版本生效，高版本走 MediaStore） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 13+ 通知权限（下载完成通知 / 后台上传进度通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 下载 APK 后跳转安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- WorkManager 后台上传任务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      「上传已安装应用」需要枚举本机应用以取回其 APK 路径。

      Android 11（API 30）起引入包可见性限制：不声明本权限时
      PackageManager.getInstalledPackages() 只会返回极少数包，
      应用列表会残缺到不可用。用 QUERY_ALL_PACKAGES 申请完整可见性。

      用途声明（应用商店审核需要）：仅在本机枚举已安装应用供用户**手动挑选**，
      取所选应用的 sourceDir 作为上传源文件；不收集、不上传、不共享应用列表，
      不涉及任何后台自动读取。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 二维码扫描（对齐原版 qr.lua）。声明为非必需，没相机的设备也能装 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".CloudBoxApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudBox"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CloudBox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 支持从外部链接唤起解析（#17 修复：限定 lanzou 系 host，
                 旧实现无 host 过滤会变成全系统所有网页链接的候选打开方式） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="lanzou.com" />
                <data android:scheme="https" android:host="*.lanzou.com" />
                <data android:scheme="https" android:host="lanzoui.com" />
                <data android:scheme="https" android:host="*.lanzoui.com" />
                <data android:scheme="https" android:host="lanzoup.com" />
                <data android:scheme="https" android:host="*.lanzoup.com" />
                <data android:scheme="https" android:host="lanzoux.com" />
                <data android:scheme="https" android:host="*.lanzoux.com" />
                <data android:scheme="https" android:host="lanzouo.com" />
                <data android:scheme="https" android:host="*.lanzouo.com" />
                <data android:scheme="https" android:host="lanzouh.com" />
                <data android:scheme="https" android:host="*.lanzouh.com" />
                <data android:scheme="https" android:host="lanzouu.com" />
                <data android:scheme="https" android:host="*.lanzouu.com" />
            </intent-filter>

            <!-- 从其他 App「分享」单个文件到云匣。
                 典型场景：文件管理器/相册/微信 选中文件 → 分享 → 云匣。
                 收到后进主界面并自动走上传流程（目标目录默认当前目录，可在界面改）。

                 注意 mimeType 用 */*：用户分享的文件类型是无穷的，
                 这里不做类型限制，接收后一律当普通文件上传。
                 （原版 App 在 home.lua 的 intent操作 里处理 ACTION_SEND，
                   把 ClipData 各项并入"批量上传数据"，与此处行为一致。） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- 从其他 App「分享」多个文件到云匣（长按多选 → 分享）。
                 与上面成对出现，缺少它会导致多选分享时云匣不出现在候选列表里。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 官方网页上传通道（兜底）：用已登录 Cookie 打开蓝奏云官方上传页。
             原生直传被风控 / 协议变更挡住时使用，与原版 App 的做法一致
             （原版 AndroLua 端没有任何 multipart 上传调用，一律 WebView 打开官方上传页）。
             不导出（无 intent-filter），只能由本 App 内部启动。 -->
        <activity
            android:name=".feature.upload.WebViewUploadActivity"
            android:exported="false"
            android:label="网页上传"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CloudBox" />

        <!-- 程序错误页（对齐原版 error_page.lua）：崩溃时展示错误信息并允许复制。
             独立 Activity + 独立任务栈：崩溃发生在导航途中时，主 Activity 状态可能
             已不一致，在里面改 UI 极易二次崩溃。不导出，仅内部拉起。 -->
        <activity
            android:name=".common.ErrorActivity"
            android:exported="false"
            android:label="程序错误"
            android:theme="@style/Theme.CloudBox" />

        <!-- 二维码扫描（对齐原版 qr.lua）：CameraX 预览 + MLKit 离线识别。
             结果通过 setResult 回传，只有一个调用方（解析页）。不导出。 -->
        <activity
            android:name=".feature.scan.ScanActivity"
            android:exported="false"
            android:label="扫描二维码"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CloudBox" />

        <!-- 应用自更新：把 cacheDir/updates/ 里的 APK 以 content:// 形式交给系统安装器。
             下载到 App 私有目录 + FileProvider 是 targetSdk 34 下唯一干净路径
             （直接交 file:// 在 Android 7+ 会抛 FileUriExposedException）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager 使用 Hilt 自定义 WorkerFactory（CloudBoxApp 实现 Configuration.Provider），
             必须移除默认初始化器，否则运行时重复初始化（lint 强制要求） -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
